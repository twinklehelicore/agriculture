generator client {
  provider = "prisma-client-js"

}
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


enum ServiceRequestStatus {
  PENDING
  APPROVED
  REJECTED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
}

enum SlotType {
  MORNING
  AFTERNOON
  EVENING
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]

  @@map("role")
}


model Crop {
  id        Int   @id @default(autoincrement())
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farms     Farm[]

  @@map("crop")
}

model ServiceType {
  id          Int   @id @default(autoincrement())
  name        String   @db.VarChar(120)     
  price       Decimal? @db.Decimal(10, 2)                      
  image       String?  @db.Text
  description String?  @db.Text
  unit        String?                       
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requests    ServiceRequest[]

  @@map("service_type")
  
}


model User {
  id           Int        @id @default(autoincrement())
  roleId       Int
  name         String?
  mobile       String?       @unique
  email        String?       @unique
  password     String?                    
  isActive     Boolean       @default(true)
  address      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

 
  role         Role     @relation(fields: [roleId], references: [id])
  farms        Farm[]
  sentRequests ServiceRequest[] @relation("FarmerToRequest")
  receivedJobs ServiceRequest[] @relation("ProviderToRequest")

  @@map("user")
}

model Otp {
  id        Int   @id @default(autoincrement())
  mobile    String   @unique
  code      String?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("otp")
}


model Farm {
  id          Int   @id @default(autoincrement())
  userId      Int
  name        String                
  area        Decimal?      @db.Decimal(5, 2)       
  cropId      Int?
  latitude    Decimal?      @db.Decimal(5, 2)
  longitude   Decimal?      @db.Decimal(5, 2)
  address     String?
  surveyNo    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  crop        Crop?    @relation(fields: [cropId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
  serviceRequest      ServiceRequest[]
  @@map("farm")
}



model ServiceRequest {
  id                Int              @id @default(autoincrement())
  farmerId          Int
  serviceTypeId     Int
  providerId        Int?
  farmId            Int
  status            ServiceRequestStatus @default(PENDING)
  details           String?                        
  visitReport       String?                        
  finalNotes        String?                        
  preferredSlot     SlotType?
  isActive          Boolean             @default(true)                    
  appliedAt         DateTime            @default(now())
  approvedAt        DateTime?
  assignedAt        DateTime?
  acceptedAt        DateTime?
  completedAt       DateTime?
  updatedAt         DateTime            @updatedAt

  farmer            User                @relation("FarmerToRequest", fields: [farmerId], references: [id])
  provider          User?               @relation("ProviderToRequest", fields: [providerId], references: [id])
  serviceType          ServiceType     @relation(fields: [serviceTypeId], references: [id])
  farm          Farm          @relation(fields: [farmId], references: [id])

  @@map("service_request")
                    
}